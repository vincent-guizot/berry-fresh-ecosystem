# ========================================================
# BERRY FRESH ECOSYSTEM — ROOT CONFIGURATION TEMPLATE
# ========================================================

# Application Core Configuration
APP_NAME=Berry Fresh Core
APP_ENV=development
APP_PORT=8080

# Database & Cache (PostgreSQL Neon / Local)
POSTGRES_USER=berry
POSTGRES_PASSWORD=fresh_secret
POSTGRES_DB=berryfresh_db
DATABASE_URL=postgres://berry:fresh_secret@localhost:5432/berryfresh_db?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Event Bus (RabbitMQ 3.13)
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=berryfresh.events

# Security & Authentication (JWT Secrets)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_here
CORS_ALLOW_ORIGINS=*

# Frontend Core API URLs
NEXT_PUBLIC_CORE_API_URL=http://localhost:8080
VITE_CORE_API_URL=http://localhost:8080

# Articles & Knowledge Hub
PORT=5000
MONGODB_URI=mongodb://localhost:27017/berryfresh_articles
VITE_ARTICLES_API_URL=http://localhost:5000/api
