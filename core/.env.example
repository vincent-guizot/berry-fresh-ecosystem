# Berry Fresh Core Configuration
APP_NAME=Berry Fresh Core
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true

# Database (PostgreSQL Neon / Local)
DATABASE_URL=postgres://berry:fresh_secret@localhost:5432/berryfresh_db?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_MAX_IDLE_TIME=15m

# Message Broker (RabbitMQ)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=berryfresh.events

# Redis Cache & Sessions
REDIS_URL=redis://localhost:6379/0

# Security & JWT
JWT_ACCESS_SECRET=berryfresh_access_super_secret_jwt_key_2026
JWT_REFRESH_SECRET=berryfresh_refresh_super_secret_jwt_key_2026
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# CORS
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173
